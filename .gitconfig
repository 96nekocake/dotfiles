[alias]
    br = branch
    cm = commit -m
    ch = checkout
    see = browse
    st = status
    gr = log --graph --date=short --decorate=short --pretty=format:'%Cgreen%h %Creset%cd %Cblue%cn %Cred%d %Creset%s'
    brdel = "!f() { test \"$#\" -eq 1 || { echo 'usage: git brdel <branch>' >&2; return 2; }; git push origin --delete \"$1\"; }; f"
    undo = reset --soft HEAD^
    sw = switch
    swc = switch -c

[include]
    path = .gitconfig.local
