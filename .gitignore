# エディタ関連
# VS Codeの設定ファイル
.vscode/
# Neovimのスワップファイル
*.swp
*.swo
*.swn
*.un~
# Neovimの履歴ファイル
.netrwhist
# Neovimの情報ファイル
.viminfo

# 一時ファイルやバックアップ
# 一時ファイル
*.tmp
*.temp
*.bak
*.old
*.orig
# ログファイル
*.log
# ロックファイル
*.lock

# macOS関連
# macOSのメタデータファイル
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Node.jsやツール関連
# Node.jsのモジュール
node_modules/
# キャッシュファイル
*.cache
package-lock.json
yarn.lock
pnpm-lock.yaml

# Luaフォーマッター設定（生成ファイル）
# Luaフォーマッターの一時設定
*.stylua.toml

# Lazy.nvim関連
nvim/lazy-lock.json

# Hyprland関連
# Hyprlandの一時ロックファイル（もしあれば）
hypr/*.lock

# その他
# 一時バックアップファイル
*.~
# Vimのバックアップファイル
*~
# ctags生成ファイル
tags
# セッションファイル
session.*

# 環境変数関連のファイル
.env
.env.*
!.env.example 
